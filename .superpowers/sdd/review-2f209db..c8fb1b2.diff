+    // 동일하게 advance-only 경로를 타도록 함수형으로 호출.
+    setScenes(() => nextScenes)
+    const nextSrtTrack = newSrtTrack ?? srtTrackRef.current
+    if (newSrtTrack) setSrtTrack(newSrtTrack)
+    return { nextScenes, nextSrtTrack }
+  }, [])
