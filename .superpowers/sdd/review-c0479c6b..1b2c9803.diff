+          outputSpec: { width: 1920, height: 1080, fps: 30 },
+        },
+      ],
+    }
+  }
+
+  it('refuses before spawning when estimated intermediates exceed free disk space', async () => {
+    const deps = makeDeps({
+      outPath: '/exports/final.mp4',
