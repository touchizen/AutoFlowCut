+  })
+
+  it('청크 경계에 걸친 SSE 라인도 정확히 파싱된다', async () => {
+    const line = `data: ${JSON.stringify({ candidates: [{ content: { parts: [{ text: '경계테스트' }] } }] })}\n\n`
