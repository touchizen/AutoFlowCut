+/* ── 에러 배너 ── */
+.story-error-banner {
+  padding: 10px 14px;
+  border-radius: var(--border-radius);
+  background: rgba(245, 101, 101, 0.12);
+  border: 1px solid var(--error-color);
+  color: var(--error-color);
+  font-size: 0.9rem;
+}
+
+/* ── 단계 패널 ── */
+.story-step-panel {
+  flex: 1;
