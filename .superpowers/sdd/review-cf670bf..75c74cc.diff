+  display: flex;
+  flex-direction: column;
+}
+
+.story-script-panel {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  height: 100%;
+}
+
+.story-title-form {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 8px;
+}
+
+.story-input {
