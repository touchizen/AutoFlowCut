+    const text = (s.text || '').trim()
+    if (!text) continue
+    const start = s.startMs || 0
+    const end = start + (s.durationMs || 0)
+    out += `${idx}\n${fmtSrtTime(start)} --> ${fmtSrtTime(end)}\n${text}\n\n`
+    idx++
+  }
+  return out.trim()
+}
