+  it('converts sfxItems seconds→ms and places at scene cumulative start', async () => {
+    const cr = { audioTracks: [], sfxItems: [{ sceneId: 'scene_2', filename: 'x', duration: 3 }] }
+    const [c] = await adaptAudioClips(cr, resolved, sceneStartsMs)
