+
+export function extractProjectIdFromUrl(href) {
+  if (!href || typeof href !== 'string') return null
+  const m = href.match(PROJECT_RE)
+  return m ? m[1] : null
+}
+
+export function resolveEffectiveProjectId(bound, extracted) {
+  return bound || extracted || null
+}
