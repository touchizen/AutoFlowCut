 function parseJsonLoose(text) {
   let t = (text || '').trim()
   const fence = t.match(/^```(?:json)?\s*([\s\S]*?)\s*```$/)
   if (fence) t = fence[1].trim()
   const s = t.indexOf('{'); const e = t.lastIndexOf('}')
   if (s >= 0 && e > s) t = t.slice(s, e + 1)
   return JSON.parse(t)
