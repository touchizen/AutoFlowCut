+
+  it('does not show the inline key field for a voice from a different provider', () => {
+    const previewState = { status: 'error', error: 'no-key', provider: 'gemini', voiceId: 'Kore' }
+    const { container } = render(
+      <VoicePicker
+        voices={voices}
+        selected={{}}
+        onSelect={vi.fn()}
+        onPreview={vi.fn()}
+        onOverrideGender={vi.fn()}
