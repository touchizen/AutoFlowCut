# Copy to `.env` and fill the DSN to enable Sentry error monitoring.
#
# Sentry activates ONLY in production builds where VITE_FUNCTION_ENV=prod
# (e.g. `npm run dist:win:nsis`, `npm run dist:mac:prod`). In dev / plain
# `npm run build` it stays disabled regardless of these values.
# Enable condition (both processes): ENABLE flag === '1' && VITE_FUNCTION_ENV === 'prod' && DSN set.
#
# A Sentry DSN is a write-only ingest key (safe to ship in the client bundle),
# but keep the real value in .env (gitignored), not here.

# --- main process ---
SENTRY_DSN=
ENABLE_SENTRY=0
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- renderer process (Vite import.meta.env, VITE_ prefix required) ---
VITE_SENTRY_DSN=
VITE_ENABLE_SENTRY=0
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
